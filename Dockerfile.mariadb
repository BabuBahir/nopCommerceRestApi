# Use MariaDB as base to get proper initialization
FROM mariadb:latest

# Install .NET 10 runtime
RUN apt-get update && \
    apt-get install -y --no-install-recommends wget && \
    wget -q https://packages.microsoft.com/config/debian/12/packages-microsoft-prod.deb -O packages-microsoft-prod.deb && \
    dpkg -i packages-microsoft-prod.deb && \
    rm packages-microsoft-prod.deb && \
    apt-get update && \
    apt-get install -y --no-install-recommends dotnet-runtime-10.0 aspnetcore-runtime-10.0 && \
    rm -rf /var/lib/apt/lists/*

# Add globalization support
RUN apt-get update && \
    apt-get install -y --no-install-recommends icu-devtools && \
    rm -rf /var/lib/apt/lists/*

ENV DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=false

# Install required packages
RUN apt-get update && \
    apt-get install -y --no-install-recommends libtiff-dev libgdiplus-dev && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy published application
COPY published/ .

ENV ASPNETCORE_URLS=http://+:80
EXPOSE 80 3306

# Create startup script
COPY start.sh /start.sh
RUN chmod +x /start.sh

ENTRYPOINT ["/start.sh"]